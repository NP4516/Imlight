<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ImlightLauncher</AssemblyName>
    <RootNamespace>Imlight.Launcher</RootNamespace>
    <!-- Overridden by the release workflow with the tag, e.g. -p:Version=1.2.0 -->
    <Version>0.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Only used by single-file publishes: roughly halves the launcher download. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="launcher.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
