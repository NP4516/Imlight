<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>ImlightSetup</AssemblyName>
    <RootNamespace>Imlight.Setup</RootNamespace>
    <!-- Overridden by the release workflow with the tag, e.g. -p:Version=1.2.0 -->
    <Version>0.0.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <!-- dotnet publish -p:ImlightEdition=Manager builds ImlightManager.exe, which installs the Niduus/Imlight fork. -->
  <PropertyGroup Condition="'$(ImlightEdition)' == 'Manager'">
    <AssemblyName>ImlightManager</AssemblyName>
    <DefineConstants>$(DefineConstants);MANAGER_EDITION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ControlPanel.html" LogicalName="ControlPanel.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the archive reader: it needs no game data to build. -->
    <ProjectReference Include="..\..\submodule\Imcodec\src\Imcodec.Wad\Imcodec.Wad.csproj" />
  </ItemGroup>

</Project>
